{
  "name": "code-review-electron",
  "version": "1.6.0",
  "description": "Electron client for the code review platform.",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:workbench": "cross-env CODE_REVIEW_UI_PREVIEW=1 electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "prepare:codegraph": "node scripts/prepare-codegraph-runtime.mjs",
    "capture:workbench": "node scripts/capture-workbench-preview.mjs",
    "capture:issue64": "node scripts/capture-issue-64-workbench.mjs",
    "dist:win": "npm run build && electron-builder --win --x64",
    "preview": "electron-vite preview",
    "preview:workbench": "cross-env CODE_REVIEW_UI_PREVIEW=1 electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "com.peicheng.code-review",
    "productName": "AI代码审查客户端",
    "directories": {
      "output": "release"
    },
    "beforePack": "scripts/prepare-codegraph-before-pack.cjs",
    "publish": [
      {
        "provider": "generic",
        "url": "http://127.0.0.1:8000/api/v1/client-updates/win32/x64"
      }
    ],
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "extraResources": [
        {
          "from": "build/codegraph-runtime/win32-x64",
          "to": "codegraph/win32-x64"
        },
        {
          "from": "resources/codegraph/legal",
          "to": "codegraph/legal"
        },
        {
          "from": "resources/codegraph/metadata.json",
          "to": "codegraph/metadata.json"
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "AI代码审查客户端.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "electron-vite": "^4.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yauzl": "^3.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "cross-env": "^7.0.3",
    "electron": "^39.2.6",
    "electron-builder": "22.14.13",
    "jsdom": "^24.1.3",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.1.7"
  }
}
