PORT=8787
TB_BATCH_CONCURRENCY=5
HOST=0.0.0.0
CODEX_BIN=/home/gpt/.local/bin/codex

# Use a host-reachable Postgres URL for the CCH database.
CCH_DATABASE_URL=postgresql://user:password@127.0.0.1:PORT/database
SESSION_SECRET=change-me
SESSION_TTL_HOURS=24
CCH_SYNC_INTERVAL_MS=60000

# Optional: used by /api/credential-health to show whether TB credentials are present.
TEAMBITION_APP_ID=
TEAMBITION_APP_SECRET=
TEAMBITION_APP_ACCESS_TOKEN=
TEAMBITION_APP_KEY=
TEAMBITION_CLIENT_ID=
TEAMBITION_TOKEN=
